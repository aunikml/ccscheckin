# ==============================================================================
# National Child Care Summit 2026 - Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER commit secrets to version control)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# ------------------------------------------------------------------------------
# Python & Django
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/

# Django Databases & Storage
*.sqlite3
*.db
backend/db.sqlite3
backend/staticfiles/
backend/media/
media/
staticfiles/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------------------------
# Node.js & Vite Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Generated Export Files & Logs
# ------------------------------------------------------------------------------
logs/
*.log
summit_*_report_*.csv
childcare_summit_participants_*.csv

# ------------------------------------------------------------------------------
# IDEs & Editor Files
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Agent metadata
.skills.json

