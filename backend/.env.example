# Django Configuration
SECRET_KEY=replace-with-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave DB_NAME empty for SQLite local development)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=childcaresummit_db
DB_USER=childcare_user
DB_PASSWORD=YourSecurePasswordHere
DB_HOST=localhost
DB_PORT=5432

# CORS settings for React UI
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Default Initial Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@childcaresummit.org
ADMIN_PASSWORD=admin12345

# Google Sheet Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_TAB_NAME=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_JSON=

